<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listFragment">

    <fragment
        android:id="@+id/listFragment"
        android:name="com.example.prak3_scrollable.fragment.ListFragment"
        android:label="Genshin Characters"
        tools:layout="@layout/fragment_list">

        <action
            android:id="@+id/action_listFragment_to_detailFragment"
            app:destination="@id/detailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.prak3_scrollable.fragment.DetailFragment"
        android:label="Character Detail"
        tools:layout="@layout/fragment_detail">

        <argument
            android:name="character"
            app:argType="com.example.prak3_scrollable.model.Character" />

    </fragment>

</navigation>
